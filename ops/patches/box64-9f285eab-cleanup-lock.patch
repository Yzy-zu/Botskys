     void*       a;
 } cleanup_t;
 
+/* Protect the shared cleanup registries; callbacks run without this lock. */
+static pthread_mutex_t cleanup_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void cleanup_fork_prepare(void)
+{
+    pthread_mutex_lock(&cleanup_mutex);
+}
+
+static void cleanup_fork_parent(void)
+{
+    pthread_mutex_unlock(&cleanup_mutex);
+}
+
+static void cleanup_fork_child(void)
+{
+    pthread_mutex_unlock(&cleanup_mutex);
+}
+
+__attribute__((constructor))
+static void register_cleanup_atfork(void)
+{
+    pthread_atfork(cleanup_fork_prepare, cleanup_fork_parent, cleanup_fork_child);
+}
+
+void ResetCleanupMutex(void)
+{
+    /* A non-CLONE_VM child has a private copy and no surviving lock owner. */
+    pthread_mutex_init(&cleanup_mutex, NULL);
+}
